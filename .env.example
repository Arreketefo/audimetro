# Audímetro — copia a .env y rellena. El .env JAMÁS entra en git.

# Telegram (bot propio: crear AudimetroBot en @BotFather)
AUDIMETRO_TELEGRAM_BOT_TOKEN=
AUDIMETRO_TELEGRAM_CHAT_ID=

# Hora UTC del informe diario (8 UTC = 10:00 en Madrid en verano)
AUDIMETRO_DIGEST_HOUR=8

# YouTube: API key del proyecto GCP (YouTube Data API v3 habilitada)
AUDIMETRO_YOUTUBE_API_KEY=
AUDIMETRO_YOUTUBE_HANDLE=@tucanal

# YouTube Analytics (OPCIONAL): min vistos, duración media y subs por vídeo.
# Cliente OAuth "Aplicación de escritorio" del mismo proyecto GCP, con la
# pantalla de consentimiento PUBLICADA en producción (si queda en Testing el
# token caduca a los 7 días). El REFRESH_TOKEN lo imprime
# `audimetro auth youtube`.
AUDIMETRO_YT_OAUTH_CLIENT_ID=
AUDIMETRO_YT_OAUTH_CLIENT_SECRET=
AUDIMETRO_YT_REFRESH_TOKEN=

# Instagram (cuenta profesional): app de developers.facebook.com.
# APP_ID/SECRET solo hacen falta para `audimetro auth instagram`;
# el ACCESS_TOKEN lo imprime ese comando.
AUDIMETRO_IG_APP_ID=
AUDIMETRO_IG_APP_SECRET=
AUDIMETRO_IG_ACCESS_TOKEN=

# TikTok: app de developers.tiktok.com (Login Kit + scope video.list,
# modo sandbox con tu cuenta como target user). El REFRESH_TOKEN lo
# imprime `audimetro auth tiktok`.
AUDIMETRO_TT_CLIENT_KEY=
AUDIMETRO_TT_CLIENT_SECRET=
AUDIMETRO_TT_REFRESH_TOKEN=

# Solo en local (en la VM el compose fuerza /data/audimetro.db)
# AUDIMETRO_DB_PATH=./audimetro.db
